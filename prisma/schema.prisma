datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AGENT (ระบบเซลส์/นักศึกษา/คนแนะนำ)
// ==========================================
model Agent {
  id          String   @id @default(cuid())
  code        String   @unique 
  name        String   
  phone       String?
  bankDetails String?  
  isActive    Boolean  @default(true) 
  
  createdAt   DateTime @default(now())
  
  shops       Shop[]   
}

// ==========================================
// 2. SHOP (ตารางหลักของร้านค้า และ Subdomain)
// ==========================================
model Shop {
  id                 String    @id @default(cuid())
  slug               String    @unique 
  name               String
  logoUrl            String?
  themeColor         String    @default("#10b981")

  // --- Repair Shop Settings ---
  maxActiveJobs      Int       @default(10)

  // --- Billing & Subscription ---
  plan               PlanType  @default(FREE_TRIAL)
  trialEndsAt        DateTime?
  
  // 🌟 [เพิ่มใหม่] ต้องมี "วันที่เริ่มรอบบิล" เพื่อเอาไปคำนวณหักลบเวลาที่ใช้ไป (Prorate)
  subscriptionStartsAt DateTime? 
  subscriptionEndsAt   DateTime?
  
  isActive           Boolean   @default(true)

  // --- Agent & Commission Tracking ---
  agentId            String?   
  agent              Agent?    @relation(fields: [agentId], references: [id])
  isCommissionPaid   Boolean   @default(false) 

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt // 🌟 แก้บรรทัดนี้

  owners             ShopOwner[]
  services           Service[]
  queues             Queue[]
  payments           PaymentTransaction[]
}

// ==========================================
// 3. SHOP OWNER (ระบบจัดการสิทธิ์ VIP Onboarding)
// ==========================================
model ShopOwner {
  id        String   @id @default(cuid())
  userId    String?  
  email     String   
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role      Role     @default(OWNER) 

  @@unique([email, shopId]) 
}

// ==========================================
// 4. SERVICE (บริการ/หมวดหมู่อาการเสีย)
// ==========================================
model Service {
  id           String  @id @default(cuid())
  shopId       String
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  name         String  
  price        Float?
  estimatedMin Int?
  isActive     Boolean @default(true)
  @@index([shopId]) // 🌟 แนะนำให้เติม
}

// ==========================================
// 5. QUEUE (ใบสั่งซ่อม / Job Ticket)
// ==========================================
model Queue {
  id            String      @id @default(cuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  jobRef        String?     
  customerName  String      
  phoneNumber   String?     
  deviceModel   String?     
  deviceColor   String?     
  issue         String?

  // 🌟 [ปรับปรุง] เรื่องราคาและข้อมูลเฉพาะเครื่องของช่าง
  estimatedPrice Float?     // ราคาประเมินเบื้องต้น (ตรงกับ UI)
  repairCost     Float?     // ราคาซ่อมจริง (เผื่อเอาไว้สรุปยอดตอนจบงาน)
  serialNumber   String?    // 🌟 เพิ่ม S/N
  imei           String?    // 🌟 เพิ่ม IMEI     
  
  serviceName   String?     
  isManualEntry Boolean     @default(false) 

  status        QueueStatus @default(PENDING)

  // 🌟 [เพิ่มใหม่] สำหรับระบบยกเลิกงานและถังขยะ (Recycle Bin)
  cancelReason  CancelReason? // เก็บเหตุผลที่ยกเลิก
  cancelledAt   DateTime?     // เก็บ Timestamp ที่กดยกเลิก (cancel_at)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt // 🌟 อัพเดทเวลาอัตโนมัติเมื่อมีการแก้ไขข้อมูลใดๆ
  acceptedAt    DateTime?
  startedAt     DateTime?   
  repairedAt    DateTime?   
  completedAt   DateTime?
  @@index([shopId]) // 🌟 แนะนำให้เติม
}

// ==========================================
// 6. PAYMENT TRANSACTION (ประวัติการชำระเงินของร้านค้า)
// ==========================================
model PaymentTransaction {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  
  // 🌟 [ปรับปรุง] แตก Field เพื่อเก็บประวัติการหักส่วนลด Prorate แบบโปร่งใส
  amount        Float    // ยอดสุทธิที่ลูกค้าโอนจริง (เช่น 2645)
  baseAmount    Float?   // ราคาเต็มของแพ็กเกจที่เลือก (เช่น 3490)
  prorateCredit Float?   // เครดิตที่หักลบให้จากแพ็กเกจเดิม (เช่น 845)
  isUpgrade     Boolean  @default(false) // เป็นบิลอัปเกรดหรือไม่
  
  plan          PlanType 
  slipUrl       String?  
  
  status        PaymentStatus @default(PENDING) 
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt // 🌟 แนะนำให้เติม: เวลาที่มีการแก้ไขบิล (เช่น admin กด approve)
  approvedAt    DateTime?
  @@index([shopId]) // 🌟 แนะนำให้เติม
}

// ==========================================
// ENUMS
// ==========================================

// 🌟 [เพิ่มใหม่] เหตุผลการยกเลิกงาน (Cancel Reason)
enum CancelReason {
  NO_SHOW             // ลูกค้าไม่มา (ใช้ใน Board 1, 2)
  CUSTOMER_CANCEL     // ลูกค้าไม่ซ่อมแล้ว (ใช้ใน Board 1, 2, 3)
  UNREPAIRABLE        // ซ่อมไม่ได้ (ใช้ใน Board 3)
  NO_PARTS            // ไม่มีอะไหล่ (ใช้ใน Board 3)
  UNCONTACTABLE
}

// 🌟 [ปรับปรุง] แยก Basic กับ Pro ให้ชัดเจน
enum PlanType {
  FREE_TRIAL
  BASIC_MONTHLY  // เปลี่ยนชื่อจาก MONTHLY ให้ชัดเจน
  BASIC_YEARLY   // เปลี่ยนชื่อจาก YEARLY ให้ชัดเจน
  PRO_MONTHLY    // เผื่ออนาคต
  PRO_YEARLY     // แพ็กเกจที่แจ้งเตือน LINE
  LIFETIME
}

enum Role {
  OWNER
  STAFF
}

enum QueueStatus {
  PENDING
  WAITING
  PROCESSING
  REPAIRED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}