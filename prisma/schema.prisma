datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AGENT (ระบบเซลส์/นักศึกษา/คนแนะนำ)
// ==========================================
model Agent {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  phone       String?
  bankDetails String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  shops Shop[]
}

// ==========================================
// 2. SHOP (ตารางหลักของร้านค้า และ Subdomain)
// ==========================================
model Shop {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  logoUrl    String?
  themeColor String  @default("#10b981")

  isDemo     Boolean @default(false)
  creatorIp  String? // 🌟 เพิ่มฟิลด์นี้เอาไว้เก็บ IP ของคนที่กดสร้างร้าน Demo

  // --- Billing & Subscription ---
  planType   PlanType   @default(FREE_TRIAL)
  planStatus PlanStatus @default(ACTIVE)

  trialEndsAt          DateTime? // วันที่หมดช่วงทดลองใช้ฟรี
  subscriptionStartsAt DateTime? // วันที่เริ่มจ่ายเงินรอบล่าสุด (เอาไว้คำนวณ Prorate)
  expiresAt            DateTime? // 🌟 วันหมดอายุของแพ็กเกจ (ใช้ตัวนี้คำนวณทบวัน)

  isActive Boolean @default(true)

  // --- Agent & Commission Tracking ---
  agentId          String?
  agent            Agent?  @relation(fields: [agentId], references: [id])
  isCommissionPaid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Relations ---
  owners        ShopOwner[]
  services      Service[]
  queues        Queue[]
  payments      PaymentTransaction[]
  subscriptions SubscriptionHistory[]
}

// ==========================================
// 2.1 SUBSCRIPTION HISTORY (ประวัติการต่ออายุแพ็กเกจ)
// ==========================================
model SubscriptionHistory {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planType   PlanType // แพ็กเกจที่ซื้อ (BASIC_MONTHLY / BASIC_YEARLY)
  amountPaid Float // จำนวนเงินที่จ่าย (เช่น 299.00, 2290.00)

  purchasedAt       DateTime  @default(now()) // วันที่จ่ายเงิน
  previousExpiresAt DateTime? // วันหมดอายุเดิมก่อนจ่าย
  newExpiresAt      DateTime // วันหมดอายุใหม่หลังจ่าย

  slipUrl String? // ลิงก์สลิปโอนเงิน (ถ้ามี)
  status  String  @default("COMPLETED") // COMPLETED, PENDING, FAILED
}

// ==========================================
// 3. SHOP OWNER (ระบบจัดการสิทธิ์ VIP Onboarding)
// ==========================================
model ShopOwner {
  id     String  @id @default(cuid())
  userId String?
  name   String?
  email  String
  shopId String
  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role   Role    @default(OWNER)

  @@unique([email, shopId])
}

// ==========================================
// 4. SERVICE (บริการ/หมวดหมู่อาการเสีย)
// ==========================================
model Service {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name         String
  price        Float?
  estimatedMin Int?
  isActive     Boolean @default(true)

  @@index([shopId])
}

// ==========================================
// 5. QUEUE (ใบสั่งซ่อม / Job Ticket)
// ==========================================
model Queue {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  jobRef       String?
  customerName String
  phoneNumber  String?
  deviceModel  String?
  deviceColor  String?
  issue        String?

  // --- ข้อมูลสำหรับช่าง ---
  estimatedPrice Float? // ราคาประเมินเบื้องต้น
  repairCost     Float? // ราคาซ่อมจริง (เผื่อเอาไว้สรุปยอดตอนจบงาน)
  serialNumber   String? // S/N ตัวเครื่อง
  imei           String? // IMEI ตัวเครื่อง

  serviceName   String?
  serviceCategory String?

  deviceBrand     String?

  isManualEntry Boolean @default(false)

  status QueueStatus @default(PENDING)

  // --- ข้อมูลการยกเลิกงาน ---
  cancelReason CancelReason?
  cancelledAt  DateTime?

  // --- Timestamps ---
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  startedAt   DateTime?
  repairedAt  DateTime?
  completedAt DateTime?

  // ระบบคลังประกัน (Warranty Archive)
  isInWarranty       Boolean   @default(false)
  warrantyArchivedAt DateTime?
  warrantyUntil      DateTime?

  // 🌟 UNIQUE กัน jobRef ซ้ำในร้านเดียวกัน
  @@unique([shopId, jobRef])

  // ANALYTICS SAFE SOFT DELETE
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // QUEUE IMAGE SYSTEM
  images String[] @default([])

  // Index เพื่อให้ Query หน้าบอร์ด (ที่ isDeleted = false) ทำงานได้เร็วเสมอ
  @@index([shopId, isDeleted])

  // Index เร่งความเร็วหน้า Report และ History ที่ต้องเรียงตามเวลา
  @@index([shopId, createdAt(sort: Desc)])

  // Index สำหรับดึงข้อมูล Top 50 แบบ Priority ได้เร็วที่สุด
  @@index([shopId, status, updatedAt(sort: Desc)])
  // Index เพื่อให้การดึงข้อมูลและรัน Cron Job ทำได้เร็วขึ้นสุดๆ (O(log n))
  @@index([shopId, isInWarranty, warrantyUntil])

  @@index([shopId, phoneNumber])
  @@index([shopId, customerName])

  // Index เพื่อให้ Analytics (groupBy) ทำงานได้รวดเร็ว
  @@index([shopId, serviceCategory])
  @@index([shopId, deviceBrand])
  @@index([shopId, deviceModel])
}

// ==========================================
// 6. PAYMENT TRANSACTION (ประวัติการชำระเงินของร้านค้า)
// ==========================================
model PaymentTransaction {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  amount        Float // ยอดสุทธิที่ลูกค้าโอนจริง
  baseAmount    Float? // ราคาเต็มของแพ็กเกจที่เลือก
  prorateCredit Float? // เครดิตที่หักลบให้จากแพ็กเกจเดิม
  isUpgrade     Boolean @default(false) // เป็นบิลอัปเกรดหรือไม่

  plan    PlanType
  slipUrl String?
  transRef  String?  @unique

  status PaymentStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  @@index([shopId])
}

// ==========================================
// 7. SYSTEM SETTINGS (การตั้งค่าส่วนกลางของ Super Admin)
// ==========================================
model SystemSetting {
  id          String  @id @default("global") // ใช้ ID ตายตัวว่า "global"
  promptpayId String? // เบอร์พร้อมเพย์ หรือ เลขบัตรประชาชน
  accountName String? // ชื่อบัญชีรับเงิน

  updatedAt DateTime @updatedAt
}

// ==========================================
// ENUMS
// ==========================================

enum CancelReason {
  NO_SHOW // ลูกค้าไม่มา
  CUSTOMER_CANCEL // ลูกค้าไม่ซ่อมแล้ว
  UNREPAIRABLE // ซ่อมไม่ได้
  NO_PARTS // ไม่มีอะไหล่
  UNCONTACTABLE // ติดต่อไม่ได้
}

enum PlanType {
  FREE_TRIAL
  BASIC_MONTHLY
  BASIC_YEARLY
  PRO_MONTHLY
  PRO_YEARLY
  LIFETIME
}

enum PlanStatus {
  ACTIVE
  EXPIRED
}

enum Role {
  OWNER
  STAFF
}

enum QueueStatus {
  PENDING
  WAITING
  PROCESSING
  REPAIRED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// 8. CAROUSEL ITEM (ภาพแบนเนอร์/โฆษณา หน้า Landing Page)
// ==========================================
model CarouselItem {
  id        String   @id @default(cuid())
  
  // 🌟 ข้อมูลหลักที่ต้องโชว์
  imageUrl  String   // URL ของรูปภาพ (บังคับมี)
  title     String?  // หัวข้อ (เผื่อแอดมินใส่ไว้โน้ตดูเอง หรือถ้าอนาคตอยากให้มี Text วางทับรูป)
  link      String?  // ลิงก์ปลายทางเมื่อลูกค้าคลิกรูป (เช่น #pricing, /register, https://...)

  // 🌟 ข้อมูลสถานะและการจัดเรียง
  isActive  Boolean  @default(true) // เปิด/ปิด การแสดงผล
  order     Int      @default(0)    // ลำดับการแสดงผล (เอาไว้ทำ Drag & Drop Sort)

  // 🌟 ข้อมูลเชิงสถิติเบื้องต้น (Optional - แนะนำให้มีไว้เพื่อ Tracking)
  clickCount Int     @default(0)    // จำนวนครั้งที่คนคลิก (เอาไว้ทำ A/B Test หรือดูว่าคนสนใจโปรไหน)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 🌟 Index เพื่อให้ดึงข้อมูลมาเรียงลำดับที่หน้า Landing ได้เร็วที่สุด
  @@index([isActive, order])
}
